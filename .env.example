# Copy this file to .env, or start from one of the presets:
#   .env.personal.example    one person, on their own computer
#   .env.enterprise.example  a team, invite-only
#   .env.demo.example        a public demo with simulated AI
# Replace EVERY CHANGE_ME. Never commit .env.
#
# EDITION is personal or enterprise.
EDITION=CHANGE_ME
# REGISTRATION_MODE is open, invite, first_user or closed.
REGISTRATION_MODE=CHANGE_ME
DB_OWNER_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME
# Only for REGISTRATION_MODE=invite (at least 12 characters):
# INVITE_CODE=CHANGE_ME
# Optional model choices (the model-puller downloads these):
# CHAT_MODEL=llama3.2:3b
# EMBED_MODEL=nomic-embed-text
