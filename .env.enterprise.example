# A team. Organizations, roles, shared documents and the audit log are available.
# New accounts need the invite code. Give it only to people you trust.
# Generate each secret with: python -c "import secrets; print(secrets.token_hex(32))"
EDITION=enterprise
REGISTRATION_MODE=invite
INVITE_CODE=CHANGE_ME
DB_OWNER_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME
